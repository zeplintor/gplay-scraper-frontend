# Frontend Environment Variables

# Backend API URL
VITE_API_URL=https://your-backend.onrender.com

# Stripe Public Key (safe to expose in frontend)
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_publishable_key

# SerpAPI Key (utilisé dans Netlify Functions)
SERPAPI_KEY=your_serpapi_key_here

# Success/Cancel URLs
VITE_SUCCESS_URL=https://playstore-analytics.pro/success.html
VITE_CANCEL_URL=https://playstore-analytics.pro/pricing.html
